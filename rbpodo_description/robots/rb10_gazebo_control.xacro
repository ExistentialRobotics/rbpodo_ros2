<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:macro name="ignition_ros2_control_plugin" params="prefix:='' namespace:='' ros2_control_params:=''">

    <gazebo>
      <plugin filename="libign_ros2_control-system.so" name="ign_ros2_control::IgnitionROS2ControlPlugin">
        <xacro:if value="${ros2_control_params != ''}">
          <parameters>${ros2_control_params}</parameters>
        </xacro:if>
        <xacro:if value="${namespace != ''}">
          <ros>
              <namespace>${namespace}</namespace>
          </ros>
        </xacro:if>
      </plugin>
    </gazebo>

  </xacro:macro>

  <xacro:macro name="gazebo_ros2_control_plugin" params="ros2_control_params:=''">

    <gazebo>
      <plugin filename="libgazebo_ros2_control.so" name="gazebo_ros2_control">
        <robot_sim_type>gazebo_ros2_control/GazeboSystem</robot_sim_type>
        <xacro:if value="${ros2_control_params != ''}">
          <parameters>${ros2_control_params}</parameters>
        </xacro:if>
      </plugin>
    </gazebo>

  </xacro:macro>
</robot>